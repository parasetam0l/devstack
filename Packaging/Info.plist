<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key><string>en</string>
    <key>CFBundleDisplayName</key><string>DevStack</string>
    <key>CFBundleExecutable</key><string>DevStack</string>
    <key>CFBundleIdentifier</key><string>app.devstack.desktop</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>CFBundleName</key><string>DevStack</string>
    <key>CFBundleIconFile</key><string>DevStack.icns</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>0.3.3</string>
    <key>CFBundleVersion</key><string>13</string>
    <!-- The app runs on macOS 15. While a release still bundles runtimes,
         package-release.sh raises this to the newest macOS they require. -->
    <key>LSMinimumSystemVersion</key><string>15.0</string>
    <key>LSApplicationCategoryType</key><string>public.app-category.developer-tools</string>
    <key>NSHumanReadableCopyright</key><string>Copyright © 2026 DevStack contributors. MIT licensed.</string>
    <key>NSPrincipalClass</key><string>NSApplication</string>
    <key>NSHighResolutionCapable</key><true/>
    <!-- Updates (Sparkle): the feed is appcast.xml on the latest published
         release. An update installs only if it is signed with the private
         half of SUPublicEDKey (docs/RELEASING.md). -->
    <key>SUFeedURL</key><string>https://github.com/parasetam0l/devstack/releases/latest/download/appcast.xml</string>
    <key>SUPublicEDKey</key><string>lO62GBsqaJOhK38EWuoA6WvrrKMFdgil+jI1PSEzxF8=</string>
    <key>SUEnableAutomaticChecks</key><true/>
    <key>SUScheduledCheckInterval</key><integer>86400</integer>
</dict>
</plist>
